# Production Environment Configuration
# Copy this file to .env and fill in actual values
# NEVER commit the actual .env file to version control

# =============================================================================
# TELEGRAM BOT CONFIGURATION
# =============================================================================
# Obtain from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Management chat ID for receiving daily reports and critical alerts
# Use /start command and check logs for your chat_id, or use @userinfobot
MANAGEMENT_CHAT_ID=your_management_chat_id

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL connection string
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://cashflow_user:secure_password_here  # pragma: allowlist secret@localhost:5432/cashflow_db

# Database connection pool settings
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# =============================================================================
# TIMEZONE CONFIGURATION
# =============================================================================
# Indonesia Western Time (WITA) = UTC+8
# Used for daily report generation at 24:00 WITA
TIMEZONE=Asia/Makassar

# =============================================================================
# SCHEDULER CONFIGURATION
# =============================================================================
# Daily report generation time in WITA (HH:MM format)
DAILY_REPORT_TIME=00:00

# Daily counter reset time in WITA (HH:MM format)
DAILY_COUNTER_RESET_TIME=00:01

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format: json or text
LOG_FORMAT=json

# Log output: stdout, file, or both
LOG_OUTPUT=both

# Log file path (if LOG_OUTPUT includes 'file')
LOG_FILE_PATH=/opt/cashflow-bot/logs/cashflow-bot.log

# Log rotation settings
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=5

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# Enable rate limiting for duplicate transaction detection
ENABLE_DUPLICATE_DETECTION=true

# Duplicate detection time window in seconds (default: 60)
DUPLICATE_DETECTION_WINDOW=60

# Maximum amount allowed for single transaction (in Rupiah)
MAX_TRANSACTION_AMOUNT=10000000000  # 10 billion

# Failed authentication attempts before notification
MAX_AUTH_ATTEMPTS=3

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================
# Enable metrics collection
ENABLE_METRICS=true

# Metrics export port (if using Prometheus)
METRICS_PORT=8000

# Enable correlation IDs in logs
ENABLE_CORRELATION_IDS=true

# Enable structured audit logging
ENABLE_AUDIT_LOG=true

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================
# Transaction confirmation timeout (seconds)
TRANSACTION_TIMEOUT=2

# Daily summary generation timeout (seconds)
SUMMARY_TIMEOUT=5

# Report delivery timeout (seconds)
REPORT_TIMEOUT=60

# Telegram API rate limit (messages per second)
TELEGRAM_RATE_LIMIT=30

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable keyboard navigation
ENABLE_KEYBOARDS=true

# Enable transaction history
ENABLE_HISTORY=true

# Enable automated daily reports
ENABLE_AUTOMATED_REPORTS=true

# =============================================================================
# BACKUP & MAINTENANCE
# =============================================================================
# Database backup schedule (cron format)
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2:00 AM

# Backup retention days
BACKUP_RETENTION_DAYS=30

# Enable automatic database maintenance
ENABLE_AUTO_MAINTENANCE=true

# =============================================================================
# ALERTING CONFIGURATION
# =============================================================================
# Send critical alerts to management chat
ENABLE_CRITICAL_ALERTS=true

# Alert for report delivery failures
ALERT_ON_REPORT_FAILURE=true

# Alert for bot downtime > N minutes
DOWNTIME_ALERT_THRESHOLD_MINUTES=5

# Alert for high error rate (errors per minute)
ERROR_RATE_ALERT_THRESHOLD=10

# =============================================================================
# DEVELOPMENT/STAGING OVERRIDES (remove in production)
# =============================================================================
# Uncomment for development/staging environments
# DEBUG=true
# TESTING=true
# SKIP_AUTH_CHECK=false  # NEVER set to true in production
