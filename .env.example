# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11  # pragma: allowlist secret
MANAGEMENT_CHAT_ID=-1001234567890

# Database Configuration (PostgreSQL 15+)
DATABASE_URL=postgresql://cashflow_user:password@localhost:5432/cashflow_db  # pragma: allowlist secret

# Application Settings
ENVIRONMENT=development
DEBUG=false
TIMEZONE=Asia/Makassar

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Transaction Validation
MAX_AMOUNT=10000000000
DUPLICATE_DETECTION_WINDOW_SECONDS=60

# Daily Report Scheduler (WITA timezone)
DAILY_REPORT_HOUR=0
DAILY_REPORT_MINUTE=0
REPORT_RETRY_INTERVAL_MINUTES=5
REPORT_RETRY_MAX_MINUTES=30
